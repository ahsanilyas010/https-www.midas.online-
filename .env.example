# LeadCallient — environment variables.
#
# The demo (sample data, /login demo roles) needs none of these. They switch
# on real customer accounts and card payments. Set them in Vercel under
# Project → Settings → Environment Variables. See "Sign-ups, Firebase and
# Stripe" in README.md for where each value comes from.

# --- Firebase (customer logins, workspaces, plans) --------------------------
# Until all four are set, sign-ups are kept in server memory only (preview).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The service account's private key, including the BEGIN/END lines. "\n"
# escapes are fine.
FIREBASE_PRIVATE_KEY=
# Project settings → General → Web API key.
FIREBASE_WEB_API_KEY=

# --- Stripe (upgrades, card payments) -----------------------------------------
STRIPE_SECRET_KEY=
# A recurring per-seat monthly price, graduated, with seats 1–3 at $0 (the free agents).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
